{
  "name": "dsh-wecom-notice",
  "version": "0.4.0",
  "description": "企业微信群机器人通知插件：agent 回合结束 / 需要审批 / 出错时按自定义文本模板推送到企业微信群，支持 {workspace}/{session}/{summary} 等占位符、text/markdown 消息类型、事件开关与防抖合并；设置页可视化配置并一键测试。WeCom group-robot notifier with customizable message templates for DeepSeek Harness.",
  "author": "SimonTigers",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wecom",
    "wecom-robot",
    "notify",
    "notification",
    "企业微信",
    "通知"
  ]
}